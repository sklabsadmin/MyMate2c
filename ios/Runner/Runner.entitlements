<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple asks for the invocation domains on the full app as well as the
	     Clip. With the applinks entry in the site association file, campaign
	     links (/c/zeus) open the installed app instead of Safari. Xcode adds
	     com.apple.developer.associated-appclip-app-identifiers here itself at
	     archive time. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:chat.deeploveechoes.com</string>
		<string>applinks:chat.deeplovepoems.com</string>
	</array>
</dict>
</plist>
