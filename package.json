{
  "devDependencies": {
    "wrangler": "^4.118.0"
  },
  "scripts": {
    "test": "node --test \"backend/test/*.test.mjs\"",
    "build:web": "bash tool/build_web.sh",
    "deploy": "bash tool/preflight_deploy.sh && bash tool/build_web.sh release && wrangler deploy && bash tool/verify_deploy.sh https://chat.deeploveechoes.com && bash tool/smoke_test.sh https://chat.deeplovepoems.com && bash tool/assert_domains.sh",
    "preview": "wrangler dev",
    "preview:local": "bash tool/preview_web.sh serve",
    "preview:shot": "bash tool/preview_web.sh shot",
    "smoke": "bash tool/smoke_test.sh",
    "openers": "node tool/openers.mjs",
    "gen:starters": "node tool/gen_starters.mjs",
    "deploy:recheck": "bash tool/assert_domains.sh --delay 300",
    "check:domains": "bash tool/assert_domains.sh"
  },
  "allowScripts": {
    "workerd@1.20260730.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
